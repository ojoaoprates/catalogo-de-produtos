@using CatalogoProdutos.Models
@{
    ViewData["Title"] = ViewBag.Titulo ?? "Produtos";
    var produtos = ViewBag.Produtos as List<Product>;
}

<h2>@ViewData["Title"]</h2>

@if (produtos == null || produtos.Count == 0)
{
    <p>Nenhum produto encontrado.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Descrição</th>
                <h>Preço (R$)</h>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in produtos)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Nome</td>
                    <td>@p.Categoria</td>
                    <td>@p.Descricao</td>
                    <td>@p.Preco.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
}